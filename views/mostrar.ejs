<main class="container mt-5">
  <h1 class="mb-4">Ficha de Película</h1>
  <div class="card">
    <div class="card-body">
      <h2 class="card-title"><%= pelicula.titulo %></h2>
      <h5 class="card-subtitle mb-2 text-muted">Año: <%= pelicula.anio %></h5>
      <p class="card-text">Director: <%= pelicula.director %></p>
      <p class="card-text">Género: <%= pelicula.genero %></p>
      <p class="card-text">Sinopsis: <%= pelicula.sinopsis %></p>
    </div>
  </div>
</main>
